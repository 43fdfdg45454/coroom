;
; coroomvhid.inf - coroom virtual gamepad driver (UMDF2 HID minidriver under mshidumdf.sys).
;
; Installs coroomvhid.dll on the root devices Root\coroomvhid that install.ps1 creates, one per
; slot. Each one is a HID device (class HIDClass) with two top-level collections: the gamepad
; ("HID-compliant game controller") and coroom's control collection.
;
; Two variants of the same installation, as Microsoft's vhidmini2 UMDF2 sample:
;   - Windows 11 (build 22000 or later): the inbox MsHidUmdf.inf and WUDFRD.inf through
;     Include/Needs, as the current sample;
;   - Windows 10 22H2 (VB, build 19041 and later): MsHidUmdf.inf does not exist there, so the
;     mshidumdf and WUDFRd services are added explicitly, as the sample did before build 22000.
; Both are inbox drivers signed by Microsoft; the only file of this package is the user-mode DLL.
;
; build.ps1 fills in DriverVer and $UMDFVERSION$ (stampinf) and creates the catalog (Inf2Cat).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %ProviderName%
CatalogFile = coroomvhid.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
coroomvhid.dll = 1,,

[Manufacturer]
%ManufacturerName% = Coroom,NT$ARCH$.10.0...19041,NT$ARCH$.10.0...22000

[Coroom.NT$ARCH$.10.0...22000]
%DeviceDesc% = CoroomVhid, Root\coroomvhid

[Coroom.NT$ARCH$.10.0...19041]
%DeviceDesc% = CoroomVhid_Win10, Root\coroomvhid

[CoroomVhid_CopyFiles]
coroomvhid.dll

; ---------------------------------------------------------------------------------------------
; Windows 11: MsHidUmdf.inf (build 22000 and later) and WUDFRD.inf
; ---------------------------------------------------------------------------------------------

[CoroomVhid.NT]
CopyFiles = CoroomVhid_CopyFiles
Include = MsHidUmdf.inf
Needs = MsHidUmdf.NT
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT

[CoroomVhid.NT.HW]
Include = MsHidUmdf.inf
Needs = MsHidUmdf.NT.hw
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT.hw

[CoroomVhid.NT.Services]
Include = MsHidUmdf.inf
Needs = MsHidUmdf.NT.Services
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT.Services

[CoroomVhid.NT.Filters]
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT.Filters

[CoroomVhid.NT.Wdf]
UmdfService                = coroomvhid, CoroomVhid_UmdfService
UmdfServiceOrder           = coroomvhid
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction    = Copy
UmdfFsContextUsePolicy     = CanUseFsContext2

; ---------------------------------------------------------------------------------------------
; Windows 10 22H2: the same services, added explicitly
; ---------------------------------------------------------------------------------------------

[CoroomVhid_Win10.NT]
CopyFiles = CoroomVhid_CopyFiles

[CoroomVhid_Win10.NT.HW]
AddReg = CoroomVhid_Win10_AddReg

[CoroomVhid_Win10_AddReg]
; The UMDF reflector below mshidumdf.sys (FLG_ADDREG_TYPE_MULTI_SZ | FLG_ADDREG_APPEND).
HKR,,"LowerFilters",0x00010008,"WUDFRd"

[CoroomVhid_Win10.NT.Services]
AddService = WUDFRd,0x000001f8,CoroomVhid_WudfRd_Service
; 0x2 (SPSVCINST_ASSOCSERVICE): mshidumdf.sys is the function driver of the device.
AddService = mshidumdf,0x000001fa,CoroomVhid_MsHidUmdf_Service

[CoroomVhid_WudfRd_Service]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\WUDFRd.sys

[CoroomVhid_MsHidUmdf_Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\mshidumdf.sys

[CoroomVhid_Win10.NT.Wdf]
UmdfService                = coroomvhid, CoroomVhid_UmdfService
UmdfServiceOrder           = coroomvhid
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction    = Copy
UmdfFsContextUsePolicy     = CanUseFsContext2

; ---------------------------------------------------------------------------------------------
; Common
; ---------------------------------------------------------------------------------------------

[CoroomVhid_UmdfService]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary      = %13%\coroomvhid.dll

[Strings]
ProviderName      = "coroom"
ManufacturerName  = "coroom"
DiskName          = "Driver de mando virtual de coroom"
DeviceDesc        = "Mando virtual de coroom"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
