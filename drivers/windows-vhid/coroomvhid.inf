;
; coroomvhid.inf - coroom virtual gamepad driver (UMDF2, protocol 3).
;
; Installs coroomvhid.dll on the root devices that install.ps1 creates:
;   - Root\coroomvhid (one): the control device, a HID source driver of the Virtual HID Framework.
;     vhf.sys (inbox) is its lower filter; the gamepads it creates with VhfCreate appear as its
;     children ("HID-compliant game controller") with the identity the client gives.
;   - Root\coroomxusb (COROOM_VHID_XUSB_SLOTS of them): Xbox 360 controllers for XInput, through
;     the xusb22 device interface. "xinputhid" in UpperFilters is only the mark that
;     Windows.Gaming.Input looks for on XUSB devices; xinputhid.sys does not attach to a device of
;     class System.
;
; WUDFRd.sys (inbox) is the function driver of both and loads the DLL in WUDFHost.exe; the same
; sections serve Windows 10 22H2 and Windows 11. Both are inbox drivers signed by Microsoft; the
; only file of this package is the user-mode DLL.
;
; build.ps1 fills in DriverVer and $UMDFVERSION$ (stampinf) and creates the catalog (Inf2Cat).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = coroomvhid.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
coroomvhid.dll = 1,,

[Manufacturer]
%ManufacturerName% = Coroom,NT$ARCH$.10.0...19041

[Coroom.NT$ARCH$.10.0...19041]
%ControlDesc% = CoroomControl, Root\coroomvhid
%XusbDesc%    = CoroomXusb, Root\coroomxusb

[CoroomVhid_CopyFiles]
coroomvhid.dll

; ---------------------------------------------------------------------------------------------
; Control device: HID source driver over vhf.sys
; ---------------------------------------------------------------------------------------------

[CoroomControl.NT]
CopyFiles = CoroomVhid_CopyFiles

[CoroomControl.NT.HW]
AddReg = CoroomControl_AddReg

[CoroomControl_AddReg]
; vhf.sys below the reflector (FLG_ADDREG_TYPE_MULTI_SZ | FLG_ADDREG_APPEND), in its user-mode
; mode.
HKR,,"LowerFilters",0x00010008,"vhf"
HKR,,"VhfMode",0x00010001,1
HKR,,"CoroomKind",0x00010001,0
; One handle at a time (the client's): closing it removes its gamepads.
HKR,,"Exclusive",0x00010001,1
; Only SYSTEM, administrators and the user signed in at the computer can open it.
HKR,,"Security",,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[CoroomControl.NT.Services]
; 0x2 (SPSVCINST_ASSOCSERVICE): WUDFRd.sys is the function driver of the device.
AddService = WUDFRd,0x000001fa,CoroomVhid_WudfRd_Service

[CoroomControl.NT.Wdf]
UmdfService              = coroomvhid, CoroomVhid_UmdfService
UmdfServiceOrder         = coroomvhid
UmdfHostProcessSharing   = ProcessSharingDisabled

; ---------------------------------------------------------------------------------------------
; Xbox 360 devices (XUSB)
; ---------------------------------------------------------------------------------------------

[CoroomXusb.NT]
CopyFiles = CoroomVhid_CopyFiles

[CoroomXusb.NT.HW]
AddReg = CoroomXusb_AddReg

[CoroomXusb_AddReg]
HKR,,"UpperFilters",0x00010008,"xinputhid"
HKR,,"CoroomKind",0x00010001,1
; Games open it as any user (XInput); the private IOCTLs only work for the client that activated
; the slot.
HKR,,"Security",,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;WD)"

[CoroomXusb.NT.Services]
AddService = WUDFRd,0x000001fa,CoroomVhid_WudfRd_Service

[CoroomXusb.NT.Wdf]
UmdfService                = coroomvhid, CoroomVhid_UmdfService
UmdfServiceOrder           = coroomvhid
UmdfHostProcessSharing     = ProcessSharingDisabled
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction    = Copy
UmdfFsContextUsePolicy     = CanUseFsContext2

; ---------------------------------------------------------------------------------------------
; Common
; ---------------------------------------------------------------------------------------------

[CoroomVhid_WudfRd_Service]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\WUDFRd.sys

[CoroomVhid_UmdfService]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary      = %13%\coroomvhid.dll

[Strings]
ProviderName      = "coroom"
ManufacturerName  = "coroom"
DiskName          = "Driver de mando virtual de coroom"
ControlDesc       = "Mandos virtuales de coroom"
XusbDesc          = "Mando de Xbox 360 de coroom"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
