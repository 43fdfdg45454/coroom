<?xml version="1.0" encoding="utf-8"?>
<!--
  coroomvhid.dll: UMDF2 driver (HID source driver of the Virtual HID Framework and Xbox 360
  devices), with the project settings of Microsoft's vhidmini2 UMDF2 sample
  (hid/vhidmini2/driver/umdf2/VhidminiUm.vcxproj) plus VhfUm.lib. Needs
  Visual Studio 2022 or 2026 (or its Build Tools) with the Windows SDK and the WDK of the same
  version (10.0.26100 or later) and its Visual Studio extension, or the EWDK. See README.md.

  MSBuild compiles the DLL and stamps the INF (DriverVer, $UMDFVERSION$); build.ps1 then verifies
  the INF, signs the DLL, creates the catalog with Inf2Cat and signs it, so Inf2Cat, InfVerif and
  signing are off here.
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{AF6DF77A-E68E-4474-B5EF-FCDB75B996C2}</ProjectGuid>
    <RootNamespace>coroomvhid</RootNamespace>
    <ProjectName>coroomvhid</ProjectName>
    <!-- UMDF 2.31 is the version inbox in Windows 10 2004-22H2, the oldest system supported. -->
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <UMDF_VERSION_MINOR>31</UMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>UMDF</DriverType>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <SpectreMitigation>Spectre</SpectreMitigation>
    <!-- build.ps1 does these after compiling (see the comment at the top). -->
    <SignMode>Off</SignMode>
    <EnableInf2cat>false</EnableInf2cat>
    <SkipPackageVerification>true</SkipPackageVerification>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <TargetName>coroomvhid</TargetName>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>%(PreprocessorDefinitions);_UNICODE;UNICODE</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(DDK_INC_PATH);$(DDK_INC_PATH)\wdm;$(ProjectDir)</AdditionalIncludeDirectories>
      <ExceptionHandling>
      </ExceptionHandling>
      <!-- Static CRT: the DLL must not depend on the Visual C++ redistributable. -->
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <TreatLinkerWarningAsErrors>true</TreatLinkerWarningAsErrors>
      <AdditionalDependencies>%(AdditionalDependencies);mincore.lib;VhfUm.lib</AdditionalDependencies>
      <!-- build.ps1 passes the folder of VhfUm.lib (Lib\<version>\um\<arch> of the WDK). -->
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories);$(CoroomVhfLibDir)</AdditionalLibraryDirectories>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <!-- DriverVer = the coroom version when build.ps1 passes it (otherwise stampinf makes one). -->
    <Inf Condition="'$(CoroomDriverVersion)' != ''">
      <TimeStamp>$(CoroomDriverVersion)</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="coroomvhid.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="coroom_vhid.h" />
    <ClInclude Include="driver.h" />
    <None Include="report_descriptor.inc" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="coroomvhid.inf" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
