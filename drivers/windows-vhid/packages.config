<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK and Windows SDK as NuGet packages (the official distribution since WDK 10.0.26100): headers,
  libraries and tools (stampinf, inf2cat, infverif) for both platforms, with the version pinned.
  `nuget restore packages.config -PackagesDirectory packages` fills packages\ and
  Directory.Build.props picks them up; without packages\ the build uses the installed WDK/EWDK.
  The MSBuild driver toolset itself (WindowsUserModeDriver10.0) still comes from the Visual
  Studio "Windows Driver Kit" component.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.arm64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.arm64" version="10.0.28000.2526" targetFramework="native" />
</packages>
