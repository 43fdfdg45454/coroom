# Copia este fichero a deploy/.env (que está en .gitignore) y pon ahí los valores reales.
# Todos los valores de este ejemplo son ficticios.

# Imagen y versión (docker compose pull las descarga de GHCR; docker compose up -d --build las
# compila desde el repositorio). Los clientes y el servidor deben ser de la misma versión del
# protocolo.
COROOM_VERSION=1.0.0
# COROOM_IMAGE=ghcr.io/43fdfdg45454/coroom-server

# Nombre público del servidor: el del certificado y el de la URL de los clientes
# (https://coroom.example.com). Debe apuntar a la IP pública del servidor.
COROOM_PUBLIC_HOST=coroom.example.com

# Certificado TLS: acme (automático, Let's Encrypt), files (certificado del operador) o
# self-signed (solo desarrollo; los clientes fijan su huella con --trust-fingerprint).
COROOM_TLS_MODE=acme
# COROOM_TLS_MODE=self-signed

# ACME. Para pruebas sin gastar el límite de Let's Encrypt, su entorno de pruebas:
# COROOM_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
COROOM_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# Correo de contacto para avisos de la autoridad ACME (opcional).
# COROOM_ACME_CONTACT=admin@example.com
# Reto: tls-alpn-01 (TCP 443, por defecto) o http-01 (TCP 80; descomenta también el puerto 80 en
# docker-compose.yml).
COROOM_ACME_CHALLENGE=tls-alpn-01

# Solo con COROOM_TLS_MODE=files (rutas dentro del contenedor; ver el volumen ./certs en
# docker-compose.yml).
# COROOM_TLS_CERT=/certs/fullchain.pem
# COROOM_TLS_KEY=/certs/privkey.pem

# Direcciones dentro del contenedor (docker-compose.yml las publica en los puertos 443 del host).
COROOM_BIND_UDP=[::]:4433
COROOM_BIND_TCP=[::]:8443
# Reto HTTP-01 y redirección a HTTPS (solo con COROOM_ACME_CHALLENGE=http-01).
# COROOM_BIND_HTTP=[::]:8080

# Puertos públicos (los que publica Docker en el host).
COROOM_PUBLIC_UDP_PORT=443
COROOM_PUBLIC_TCP_PORT=443

# Alta de usuarios: invite (el administrador crea usuarios o códigos de invitación) o admin (solo
# el administrador).
COROOM_REGISTRATION=invite

# Relay de medios para cuando la conexión directa no es posible.
COROOM_RELAY_ENABLED=true
# Cuota mensual por anfitrión en GB (0 = sin límite) y bitrate máximo por sala en kbit/s (0 = sin
# límite).
COROOM_RELAY_QUOTA_GB_PER_MONTH=200
COROOM_RELAY_MAX_KBPS=30000
# Dirección UDP pública del relay que se anuncia a los clientes. Dentro de Docker hay que darla (el
# contenedor no conoce su IP pública ni el puerto publicado). 192.0.2.10 es una IP de ejemplo.
COROOM_RELAY_ADDR=192.0.2.10:443

# Invitados como mucho por sala (relay incluido).
COROOM_MAX_GUESTS_PER_ROOM=8

# Directorio de datos persistentes (volumen `data`): coroom.db, acme/ y el certificado autofirmado.
COROOM_DATA_DIR=/data

# Código fuente que enlazan /version y /admin (AGPL): con un servidor modificado, el de tu fork.
# COROOM_SOURCE_URL=https://git.example.com/tu-fork/coroom

# Solo desarrollo: la señalización acepta también este token sin cuenta. No lo uses en un servidor
# público.
# COROOM_DEV_TOKEN=change-me

# Solo desarrollo: TCP sin TLS.
# COROOM_TCP_PLAIN=false

# Nivel de logs (sintaxis de tracing-subscriber EnvFilter).
RUST_LOG=info
