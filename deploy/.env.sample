# Copia este fichero a deploy/.env (que está en .gitignore) y pon ahí los valores reales.
# Todos los valores de este ejemplo son ficticios. docker-compose.yml lee cada variable de aquí;
# las que no definas toman el valor por defecto que se indica.

# Versión de la imagen (ghcr.io/43fdfdg45454/coroom-server). Servidor y clientes deben ser la
# misma versión.
COROOM_VERSION=1.0.0

# Nombre público del servidor: el del certificado y el de la URL de los clientes
# (https://coroom.example.com). Obligatorio.
COROOM_PUBLIC_HOST=coroom.example.com

# Puertos públicos del host (por defecto 443 los dos).
COROOM_PUBLIC_UDP_PORT=443
COROOM_PUBLIC_TCP_PORT=443

# Dirección UDP pública del relay que se anuncia a los clientes: IP pública del servidor y
# COROOM_PUBLIC_UDP_PORT. Obligatoria: el contenedor no conoce su IP pública. 192.0.2.10 es una IP
# de ejemplo.
COROOM_RELAY_ADDR=192.0.2.10:443

# Certificado TLS: acme (Let's Encrypt automático, por defecto), files (certificado propio en
# ./data/certs) o self-signed (solo pruebas).
COROOM_TLS_MODE=acme

# Modo files: rutas dentro del contenedor. ./data/certs del host es /data/certs.
# COROOM_TLS_CERT=/data/certs/fullchain.pem
# COROOM_TLS_KEY=/data/certs/privkey.pem

# Modo acme. Para pruebas sin gastar el límite de Let's Encrypt, su entorno de pruebas:
# COROOM_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# COROOM_ACME_CONTACT=admin@example.com
# COROOM_ACME_CHALLENGE=tls-alpn-01

# Alta de usuarios: invite (administrador y códigos de invitación, por defecto) o admin.
# COROOM_REGISTRATION=invite

# Invitados como mucho por sala (por defecto 8).
# COROOM_MAX_GUESTS_PER_ROOM=8

# Relay de medios para cuando la conexión directa no es posible. Cuota mensual por anfitrión en
# GB y bitrate máximo por sala en kbit/s (0 = sin límite, el valor por defecto).
# COROOM_RELAY_ENABLED=true
COROOM_RELAY_QUOTA_GB_PER_MONTH=200
COROOM_RELAY_MAX_KBPS=30000

# Código fuente que enlazan /version y /admin (AGPL): con un servidor modificado, el de tu fork.
# COROOM_SOURCE_URL=https://git.example.com/tu-fork/coroom

# Nivel de logs (sintaxis de tracing-subscriber EnvFilter; por defecto info).
# RUST_LOG=info
